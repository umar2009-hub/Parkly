# ==========================================
# Frontend-safe Supabase values
# These are exposed to the Vite client bundle and browser
# ==========================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==========================================
# Server/trusted runtime only
# Do NOT prefix with VITE_. This secret must NOT be in the client bundle.
# ==========================================
ADMIN_REGISTRATION_SECRET=replace-with-your-private-admin-secret
